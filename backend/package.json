        "src",
        "!*/__tests__"
    ],
    "dependencies": {
        "@loopback/boot": "^8.0.10",
        "@loopback/core": "^7.0.9",
        "@loopback/repository": "^8.0.10",
        "@loopback/rest": "^15.0.10",
        "@loopback/rest-explorer": "^8.0.10",
        "axios": "^1.15.1",
        "dotenv": "^17.4.1",
        "express-rate-limit": "^8.3.2",
        "jsonwebtoken": "^9.0.3",
        "loopback-connector-postgresql": "^7.2.3",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.5",
        "razorpay": "^2.9.6",
        "sharp": "^0.34.5",
        "socket.io": "^4.8.3",
